[Unit]
Description=Fullscreen browser for the local web application
Wants=weston.service
After=weston.service
StartLimitIntervalSec=0

[Service]
User=weston
Group=weston
StateDirectory=browser-kiosk
RuntimeDirectory=browser-kiosk
RuntimeDirectoryMode=0700
Environment=HOME=/var/lib/browser-kiosk
Environment=XDG_RUNTIME_DIR=@RUNTIMEDIR@/browser-kiosk
Environment=WAYLAND_DISPLAY=@RUNTIMEDIR@/wayland-0
EnvironmentFile=-@SYSCONFDIR@/default/browser-kiosk
ExecStart=@BINDIR@/browser-kiosk
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
